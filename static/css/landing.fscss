$bg: #0b0d14;
$bg-soft: #121522;
$panel: #171b2b;
$panel-2: #1d2233;
$hover: #232a40;
$line: #262c42;
$line-soft: #1e2336;
$ink: #eef0f7;
$muted: #9aa3bd;
$faint: #6b7390;
$accent: #7c5cff;
$accent-2: #a78bfa;
$accent-hover: #9277ff;
$accent-soft: rgba(124, 92, 255, 0.14);
$radius: 14px;
$radius-sm: 10px;
$shadow: 0 20px 60px rgba(0, 0, 0, 0.5);

@define panel(bg, line, radius, pad) {
  background: @use(bg);
  border: 1px solid @use(line);
  border-radius: @use(radius);
  padding: @use(pad);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  bg: $bg!;
  color: $ink!;
  font-family: "Inter", "Segoe UI", system-ui, sans-serif;
  fs: 16px;
  lh: 1.6;
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  max-w: 100%;
  display: block;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  fs: 15px;
  fw: 600;
  padding: 12px 22px;
  rounded: $radius-sm!;
  border: 1px solid transparent;
  transition: transform 0.12s ease, background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}

.btn:active {
  transform: translateY(1px);
}

.btn-primary {
  bg: $accent!;
  color: #fff;
  box-shadow: 0 10px 30px rgba(124, 92, 255, 0.35);
}

.btn-primary:hover {
  bg: $accent-hover!;
}

.btn-ghost {
  color: $muted!;
}

.btn-ghost:hover {
  color: $ink!;
  bg: $hover!;
}

.btn-outline {
  border: 1px solid $line!;
  color: $ink!;
}

.btn-outline:hover {
  border-color: $accent!;
  bg: $accent-soft!;
}

.navbar {
  pos: sticky;
  top: 0;
  z: 100;
  bg: rgba(11, 13, 20, 0.82);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid $line-soft!;
}

.nav-inner {
  max-w: 1120px;
  mx: auto;
  px: 24px;
  h: 64px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  fw: 800;
  fs: 19px;
  letter-spacing: -0.02em;
}

.brand .logo {
  size: 30px 30px;
  rounded: 9px;
  bg: linear-gradient(135deg, $accent!, $accent-2!);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  fs: 16px;
  fw: 800;
}

.brand .a {
  color: $accent!;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 10px;
}

.hero {
  pos: relative;
  ta: center;
  px: 24px;
  pt: 104px;
  pb: 72px;
  overflow: hidden;
}

.hero::before {
  content: "";
  pos: absolute;
  inset: -20% -20% auto -20%;
  h: 520px;
  bg: radial-gradient(620px 320px at 50% 0%, rgba(124, 92, 255, 0.22), transparent 70%);
  pointer-events: none;
}

.hero > * {
  pos: relative;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  bg: $accent-soft!;
  color: $accent-hover!;
  border: 1px solid rgba(124, 92, 255, 0.35);
  padding: 6px 14px;
  rounded: 999px;
  fs: 13px;
  fw: 600;
  mb: 22px;
}

.badge .dot {
  size: 7px 7px;
  rounded: 999px;
  bg: $accent!;
  box-shadow: 0 0 0 4px rgba(124, 92, 255, 0.2);
}

.hero h1 {
  fs: clamp(34px, 6vw, 64px);
  lh: 1.06;
  letter-spacing: -0.03em;
  max-w: 860px;
  mx: auto;
}

.hero h1 .grad {
  bg: linear-gradient(90deg, $accent!, $accent-2!);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero .lead {
  color: $muted!;
  fs: 19px;
  max-w: 620px;
  mx: auto;
  my: 22px 32px;
}

.hero .actions {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
}

.hero .note {
  color: $faint!;
  fs: 13px;
  mt: 18px;
}

.preview {
  max-w: 1040px;
  mx: auto;
  px: 24px;
  mt: -12px;
  mb: 104px;
}

.window {
  border: 1px solid $line!;
  rounded: 18px;
  bg: $panel!;
  box-shadow: $shadow!;
  overflow: hidden;
}

.window-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  px: 16px;
  py: 12px;
  bg: $bg-soft!;
  border-bottom: 1px solid $line-soft!;
}

.window-bar .dot {
  size: 11px 11px;
  rounded: 999px;
}

.dot.red { bg: #ff5f57; }
.dot.yellow { bg: #febc2e; }
.dot.green { bg: #28c840; }

.window-bar .url {
  ml: 10px;
  fs: 12px;
  color: $faint!;
  font-family: "JetBrains Mono", Consolas, monospace;
}

.app-mock {
  display: grid;
  grid-template-columns: 240px 1fr;
  min-h: 340px;
}

.mock-side {
  border-right: 1px solid $line-soft!;
  bg: $bg-soft!;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.mock-search {
  h: 34px;
  rounded: $radius-sm!;
  bg: $panel!;
  border: 1px solid $line-soft!;
}

.mock-line {
  h: 12px;
  rounded: 6px;
  bg: $hover!;
}

.mock-line.w9 { w: 90%; }
.mock-line.w7 { w: 72%; }
.mock-line.w8 { w: 82%; }
.mock-line.w6 { w: 60%; }

.mock-main {
  padding: 22px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.mock-title {
  h: 22px;
  w: 45%;
  rounded: 7px;
  bg: $line!;
}

.mock-hero {
  h: 84px;
  rounded: $radius!;
  bg: $bg-soft!;
  border: 1px solid $line-soft!;
}

.mock-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.mock-card {
  h: 74px;
  rounded: $radius-sm!;
  bg: $bg-soft!;
  border: 1px solid $line-soft!;
}

.section {
  max-w: 1120px;
  mx: auto;
  px: 24px;
}

.section-head {
  ta: center;
  mb: 48px;
}

.section-head h2 {
  fs: clamp(26px, 4vw, 36px);
  letter-spacing: -0.02em;
}

.section-head p {
  color: $muted!;
  fs: 17px;
  mt: 10px;
}

.features {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 18px;
  pb: 96px;
}

.card {
  bg: $panel!;
  border: 1px solid $line-soft!;
  rounded: $radius!;
  padding: 26px;
  transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
}

.card:hover {
  border-color: rgba(124, 92, 255, 0.4);
  transform: translateY(-3px);
  bg: $panel-2!;
}

.card .ico {
  size: 46px 46px;
  rounded: 12px;
  bg: $accent-soft!;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  fs: 20px;
  mb: 16px;
}

.card h3 {
  fs: 17px;
  mb: 8px;
}

.card p {
  color: $muted!;
  fs: 14.5px;
}

.stats {
  border-top: 1px solid $line-soft!;
  border-bottom: 1px solid $line-soft!;
  bg: $bg-soft!;
}

.stats .inner {
  max-w: 1120px;
  mx: auto;
  px: 24px;
  py: 52px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  ta: center;
}

.stat .value {
  fs: 42px;
  fw: 800;
  letter-spacing: -0.02em;
}

.stat .value.a {
  color: $accent!;
}

.stat .label {
  color: $muted!;
  fs: 14px;
  mt: 4px;
}

.cta {
  max-w: 780px;
  mx: auto;
  ta: center;
  px: 24px;
  py: 100px;
}

.cta h2 {
  fs: clamp(28px, 4vw, 40px);
  letter-spacing: -0.02em;
}

.cta p {
  color: $muted!;
  fs: 18px;
  my: 14px 30px;
}

.cta .actions {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
}

.footer {
  border-top: 1px solid $line-soft!;
}

.footer .inner {
  max-w: 1120px;
  mx: auto;
  px: 24px;
  py: 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  flex-wrap: wrap;
}

.footer .copy {
  color: $faint!;
  fs: 13.5px;
}

.footer .links {
  display: flex;
  gap: 22px;
}

.footer a {
  color: $faint!;
  fs: 13.5px;
  transition: color 0.15s ease;
}

.footer a:hover {
  color: $ink!;
}

@media (max-width: 820px) {
  .hero {
    pt: 72px;
  }

  .app-mock {
    grid-template-columns: 1fr;
  }

  .mock-side {
    display: none;
  }

  .stats .inner {
    grid-template-columns: 1fr;
    gap: 28px;
  }
}

@media (max-width: 520px) {
  .nav-links .btn-ghost {
    display: none;
  }
}
