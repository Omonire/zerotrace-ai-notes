SECRET_KEY=change-this-to-a-random-string
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
FLASK_DEBUG=false
# Superadmin login (used by /superadmin, no DB account needed)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-this-superadmin-password
# Optional: custom SQLite path (e.g. /var/data/AI_Notes.db on Render)
# DATABASE_PATH=
# Local from-scratch model (see ml/). Requires PyTorch on Python 3.10-3.12.
# Point this at a trained run directory containing ckpt.pt and tokenizer.json.
LOCAL_MODEL_PATH=ml/runs/shakespeare-mini
# Add more needed EVNs
supabase_url=https://your-supabase-url.supabase.co
supabase_key=your-supabase-key
supabase_service_role_key=your-supabase-service-role-key
supabase_storage_bucket=your-supabase-storage-bucket
# Optionally get system-propmt for user, edit below
system-propmt = "You are an AI"